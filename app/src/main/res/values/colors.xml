<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- window_background is what the window shows between Activity start and the first Compose
         frame. The fork's default theme is black (ForkUiDefaults: Dark + AMOLED + the 白い熊 yellow
         preset) regardless of the system setting, so this is black in BOTH values/ and
         values-night/ — keeping upstream's light grey here flashed white on every transition when
         the system was in light mode. splash_background is black to match the black/yellow
         launcher icon shown on the cold-start splash (and the Compose SplashScreen). -->
    <color name="window_background">#FF000000</color>
    <color name="splash_background">#FF000000</color>
</resources>